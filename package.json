{
  "name": "ramen-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud memory synchronisation and domain-hardening engine for autonomous agents (Level 1 Community Memory Commons).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@ramen-ai/node-core": "0.3.3",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "typescript": "7.0.2",
    "wrangler": "4.145.0"
  }
}
